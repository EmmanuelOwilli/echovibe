@page "/Account/ForgotPassword"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using EchoVibe.Models
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Forgot password - EchoVibe</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Forgot password</h2>
                <p class="text-muted">Enter the email for your account.</p>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert alert-success">@statusMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" @bind="email" />
                </div>

                <button type="button" class="btn btn-primary w-100" disabled="@busy" @onclick="HandleForgot">
                    @(busy ? "Please wait..." : "Get reset link")
                </button>

                @if (!string.IsNullOrEmpty(resetHref))
                {
                    <div class="alert alert-info mt-3">
                        <p class="mb-2"><strong>Click this link to set a new password:</strong></p>
                        <a href="@resetHref">Reset my password</a>
                        <p class="small text-muted mt-2 mb-0">
                            Demo mode: the link is shown here instead of email.
                        </p>
                    </div>
                }

                <p class="mt-3 mb-0">
                    <a href="/Account/Login">Back to Login</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string? errorMessage;
    private string? statusMessage;
    private string? resetHref;
    private bool busy;

    private async Task HandleForgot()
    {
        errorMessage = null;
        statusMessage = null;
        resetHref = null;

        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            errorMessage = "Enter a valid email.";
            return;
        }

        busy = true;
        try
        {
            var user = await UserManager.FindByEmailAsync(email.Trim());
            if (user is null)
            {
                errorMessage = "No account found with that email.";
                return;
            }

            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var encoded = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var encEmail = Uri.EscapeDataString(user.Email ?? email.Trim());

            // Relative path avoids http/https host issues behind Render
            resetHref = $"/Account/ResetPassword?email={encEmail}&code={encoded}";
            statusMessage = "Reset link is ready. Click it below.";
        }
        catch (Exception ex)
        {
            errorMessage = "Could not create reset link. Try again.";
            Console.WriteLine(ex);
        }
        finally
        {
            busy = false;
        }
    }
}