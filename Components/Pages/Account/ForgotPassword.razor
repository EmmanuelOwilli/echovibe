@page "/Account/ForgotPassword"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using EchoVibe.Models
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Forgot password - EchoVibe</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Forgot password</h2>
                <p class="text-muted">Enter your account email. We’ll create a reset link for you.</p>

                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert alert-info">@statusMessage</div>
                }

                @if (!string.IsNullOrEmpty(resetLink))
                {
                    <div class="alert alert-success">
                        <p class="mb-2"><strong>Reset link</strong> (for demo — copy or click):</p>
                        <a href="@resetLink">@resetLink</a>
                        <p class="small text-muted mt-2 mb-0">
                            In a full production app this link would be sent to your email.
                        </p>
                    </div>
                }

                <EditForm Model="Input" OnValidSubmit="HandleForgot">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="Input.Email" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@busy">
                        @(busy ? "Please wait..." : "Get reset link")
                    </button>
                </EditForm>

                <p class="mt-3 mb-0">
                    <a href="/Account/Login">Back to Login</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private InputModel Input { get; set; } = new();
    private string? statusMessage;
    private string? resetLink;
    private bool busy;

    private async Task HandleForgot()
    {
        busy = true;
        statusMessage = null;
        resetLink = null;

        var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
        // Same message whether user exists or not (safer), but we still generate link if found
        if (user is null)
        {
            statusMessage = "If that email is registered, a reset link is available below when the account exists.";
            busy = false;
            // For student demo, be clear:
            statusMessage = "No account found with that email, or check the spelling.";
            busy = false;
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var encoded = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
        var email = Uri.EscapeDataString(user.Email ?? Input.Email.Trim());
        resetLink = Navigation.ToAbsoluteUri($"/Account/ResetPassword?email={email}&code={encoded}").ToString();
        statusMessage = "Use the link below to choose a new password.";
        busy = false;
    }

    private sealed class InputModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}