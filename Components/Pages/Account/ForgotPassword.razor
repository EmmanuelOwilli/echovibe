@page "/Account/ForgotPassword"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using EchoVibe.Models
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore

<PageTitle>Forgot password - EchoVibe</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-3">Forgot password</h2>
                <p class="text-muted">
                    Enter the email you used to register. We only create a reset link
                    for accounts that already exist.
                </p>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                @if (!string.IsNullOrEmpty(statusMessage))
                {
                    <div class="alert alert-success">@statusMessage</div>
                }

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" type="email" @bind="email"
                           placeholder="name@example.com" />
                </div>

                <button type="button" class="btn btn-primary w-100"
                        disabled="@busy" @onclick="HandleForgot">
                    @(busy ? "Checking..." : "Get reset link")
                </button>

                @if (!string.IsNullOrEmpty(resetHref))
                {
                    <div class="alert alert-info mt-3">
                        <p class="mb-2"><strong>Account found.</strong> Click to set a new password:</p>
                        <a href="@resetHref">Reset my password</a>
                        <p class="small text-muted mt-2 mb-0">
                            For this class project the link is shown here (no email server).
                            Only a real registered email can get this link.
                        </p>
                    </div>
                }

                <p class="mt-3 mb-0">
                    <a href="/Account/Login">Back to Login</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string? errorMessage;
    private string? statusMessage;
    private string? resetHref;
    private bool busy;

    private async Task HandleForgot()
    {
        errorMessage = null;
        statusMessage = null;
        resetHref = null;

        var trimmed = (email ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(trimmed) || !trimmed.Contains('@') || !trimmed.Contains('.'))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        busy = true;
        try
        {
            // Must match a real user in the database
            var user = await UserManager.FindByEmailAsync(trimmed);

            // Also try normalized lookup if email was stored differently
            if (user is null)
            {
                var normalized = UserManager.NormalizeEmail(trimmed);
                user = await UserManager.Users
                    .FirstOrDefaultAsync(u => u.NormalizedEmail == normalized);
            }

            if (user is null)
            {
                errorMessage = "No account is registered with that email. Check the spelling or register first.";
                return;
            }

            if (string.IsNullOrWhiteSpace(user.Email))
            {
                errorMessage = "That account has no email on file.";
                return;
            }

            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var encoded = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var encEmail = Uri.EscapeDataString(user.Email);

            resetHref = $"/Account/ResetPassword?email={encEmail}&code={encoded}";
            statusMessage = "We found your account. Use the link below to choose a new password.";
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }
}