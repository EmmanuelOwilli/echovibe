
@page "/Account/Register"

<PageTitle>Registration Temporarily Closed - EchoVibe</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center p-4 p-md-5">
                    <div class="display-4 mb-3">💜</div>

                    <h1 class="h3 mb-3">EchoVibe Is Getting Ready!</h1>

                    <p class="text-muted mb-4">
                        Thank you for your interest in joining EchoVibe.
                        We are preparing something special for you.
                        Registration is temporarily closed while we get
                        everything ready for our launch.
                    </p>

                    <div class="alert alert-info">
                        Stay tuned! We'll announce when registration opens.
                    </div>

                    <a href="/" class="btn btn-primary w-100">
                        Explore EchoVibe
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
