@page "/profile"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using EchoVibe.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<PageTitle>My Profile - EchoVibe</PageTitle>

@if (user is null)
{
    <p>@(loadError ?? "Loading...")</p>
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrEmpty(user.ProfileImageUrl))
                    {
                        <img src="@user.ProfileImageUrl"
                             alt="Profile"
                             class="rounded-circle mb-3"
                             style="width:120px;height:120px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:120px;height:120px;font-size:2.5rem;">
                            @(string.IsNullOrEmpty(user.DisplayName) ? "?" : user.DisplayName[0])
                        </div>
                    }

                    <h2>@user.DisplayName</h2>
                    <p class="text-muted">@user.Email</p>

                    @if (!string.IsNullOrEmpty(user.Country))
                    {
                        <p class="mb-1"><strong>Country:</strong> @user.Country</p>
                    }

                    @if (!string.IsNullOrEmpty(user.Bio))
                    {
                        <p class="mt-2" style="white-space: pre-wrap;">@user.Bio</p>
                    }

                    <a class="btn btn-primary mt-2" href="profile/edit">Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ApplicationUser? user;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            user = await UserManager.GetUserAsync(state.User);
            if (user is null)
                loadError = "Could not load your profile. Try logging in again.";
        }
        catch
        {
            loadError = "Could not load profile right now.";
        }
    }
}