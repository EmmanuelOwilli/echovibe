@page "/search"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using EchoVibe.Data
@using EchoVibe.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Search Users - EchoVibe</PageTitle>

<h1>Search users</h1>
<p class="text-muted">Find people by display name or email.</p>

<div class="input-group mb-4" style="max-width:480px;">
    <input class="form-control"
           @bind="query"
           @bind:event="oninput"
           @onkeydown="OnKeyDown"
           placeholder="Type a name or email..." />
    <button class="btn btn-primary" @onclick="SearchAsync" disabled="@busy">
        @(busy ? "Searching..." : "Search")
    </button>
</div>

@if (searched && !results.Any())
{
    <p class="text-muted">No users found.</p>
}
else if (results.Any())
{
    <ul class="list-group" style="max-width:560px;">
        @foreach (var u in results)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(u.ProfileImageUrl))
                    {
                        <img src="@u.ProfileImageUrl"
                             class="rounded-circle"
                             style="width:40px;height:40px;object-fit:cover;"
                             alt="" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;font-weight:700;">
                            @(u.DisplayName?.FirstOrDefault() ?? '?')
                        </div>
                    }
                    <div>
                        <strong>@u.DisplayName</strong><br />
                        <small class="text-muted">@u.Email</small>
                    </div>
                </div>
            </li>
        }
    </ul>
}

@code {
    private string query = "";
    private List<ApplicationUser> results = new();
    private bool searched;
    private bool busy;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        searched = true;
        var q = query.Trim();
        if (string.IsNullOrEmpty(q))
        {
            results = new();
            return;
        }

        busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // EF can translate Contains; for case-insensitive on Postgres use EF.Functions.ILike
            results = await db.Users
                .AsNoTracking()
                .Where(u =>
                    EF.Functions.ILike(u.DisplayName, $"%{q}%") ||
                    (u.Email != null && EF.Functions.ILike(u.Email, $"%{q}%")))
                .OrderBy(u => u.DisplayName)
                .Take(20)
                .ToListAsync();
        }
        catch
        {
            // Fallback if ILike is unavailable
            await using var db = await DbFactory.CreateDbContextAsync();
            var lower = q.ToLowerInvariant();
            results = await db.Users
                .AsNoTracking()
                .Where(u =>
                    u.DisplayName.ToLower().Contains(lower) ||
                    (u.Email != null && u.Email.ToLower().Contains(lower)))
                .OrderBy(u => u.DisplayName)
                .Take(20)
                .ToListAsync();
        }
        finally
        {
            busy = false;
        }
    }
}