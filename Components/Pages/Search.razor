@page "/search"
@rendermode InteractiveServer
@attribute [Authorize]
@using EchoVibe.Data
@using EchoVibe.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>Search Users - EchoVibe</PageTitle>

<h1>Search users</h1>
<p class="text-muted">Find people by display name or email.</p>

<div class="input-group mb-4" style="max-width:480px;">
    <input class="form-control" @bind="query" @bind:event="oninput"
           placeholder="Type a name..." />
    <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
</div>

@if (searched && !results.Any())
{
    <p class="text-muted">No users found.</p>
}
else if (results.Any())
{
    <ul class="list-group" style="max-width:560px;">
        @foreach (var u in results)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(u.ProfileImageUrl))
                    {
                        <img src="@u.ProfileImageUrl" class="rounded-circle"
                             style="width:40px;height:40px;object-fit:cover;" alt="" />
                    }
                    <div>
                        <strong>@u.DisplayName</strong><br />
                        <small class="text-muted">@u.Email</small>
                    </div>
                </div>
            </li>
        }
    </ul>
}

@code {
    private string query = "";
    private List<ApplicationUser> results = new();
    private bool searched;

    private async Task SearchAsync()
    {
        searched = true;
        var q = query.Trim();
        if (string.IsNullOrEmpty(q))
        {
            results = new();
            return;
        }

        results = await Db.Users
            .Where(u => u.DisplayName.Contains(q) || (u.Email != null && u.Email.Contains(q)))
            .OrderBy(u => u.DisplayName)
            .Take(20)
            .ToListAsync();
    }
}