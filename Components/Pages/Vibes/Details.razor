@page "/vibes/{Id:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using EchoVibe.Data
@using EchoVibe.Models
@using EchoVibe.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject CloudinaryService Cloudinary

<PageTitle>@(project?.Title ?? "Post") - EchoVibe</PageTitle>

@if (project is null)
{
    <p>@(notFound ? "Post not found." : "Loading...")</p>
}
else
{
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (!string.IsNullOrEmpty(project.ImageUrl))
            {
                <img src="@project.ImageUrl"
                     alt="@project.Title"
                     class="img-fluid rounded mb-3"
                     style="width:100%; max-height:360px; object-fit:cover;" />
            }

            @if (!string.IsNullOrEmpty(project.VibeType))
            {
                <span class="badge bg-primary mb-2">@project.VibeType</span>
            }

            <h1 class="mb-3">@project.Title</h1>

            <div class="d-flex align-items-center gap-3 mb-3">
                @if (!string.IsNullOrEmpty(project.User?.ProfileImageUrl))
                {
                    <img src="@project.User.ProfileImageUrl"
                         alt="@(project.User.DisplayName)"
                         style="width:56px;height:56px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                         style="width:56px;height:56px;font-weight:700;">
                        @(project.User?.DisplayName?.FirstOrDefault() ?? '?')
                    </div>
                }
                <div>
                    <div class="fw-semibold">@(project.User?.DisplayName ?? "User")</div>
                    <div class="small text-muted">
                        @project.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        @if (!string.IsNullOrEmpty(project.User?.Country))
                        {
                            <span>· @project.User.Country</span>
                        }
                    </div>
                </div>
            </div>

            <div class="mb-3" style="white-space: pre-wrap;">@project.Description</div>

            <div class="d-flex gap-2 align-items-center mb-4 flex-wrap">
                @if (isAuthenticated)
                {
                    <button type="button"
                            class="btn @(hasLiked ? "btn-danger" : "btn-outline-danger") btn-sm"
                            @onclick="ToggleLike">
                        @(hasLiked ? "♥ Unlike" : "♡ Like") (@likeCount)
                    </button>

                    @if (!isOwnPost)
                    {
                        <button type="button"
                                class="btn @(isFollowing ? "btn-secondary" : "btn-outline-primary") btn-sm"
                                @onclick="ToggleFollow">
                            @(isFollowing ? "Unfollow" : "Follow") @(project.User?.DisplayName)
                        </button>
                    }

                    @if (isOwnPost)
                    {
                        <a class="btn btn-outline-primary btn-sm" href="@($"vibes/edit/{project.Id}")">Edit post</a>
                    }
                }
                else
                {
                    <span class="text-muted">
                        ♡ @likeCount —
                        <a href="/Account/Login">Login</a> to like
                    </span>
                }
                <a class="btn btn-outline-secondary btn-sm" href="vibes">Back to posts</a>
            </div>

            <hr />

            <h3 class="mb-3">Updates</h3>
            <p class="text-muted small">Extra messages or photos on this post.</p>

            @if (isAuthenticated && isOwnPost)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-body">
                        <label class="form-label fw-semibold">Add an update</label>
                        <textarea class="form-control mb-2" rows="3" @bind="newPostText"
                                  placeholder="A quote, a thought, something that helps..."></textarea>
                        <InputFile class="form-control mb-2" OnChange="OnPostFile" accept="image/*" />
                        <button type="button" class="btn btn-primary btn-sm" @onclick="AddPost"
                                disabled="@(string.IsNullOrWhiteSpace(newPostText) || postBusy)">
                            @(postBusy ? "Posting..." : "Share update")
                        </button>
                        @if (!string.IsNullOrEmpty(postError))
                        {
                            <div class="text-danger small mt-2">@postError</div>
                        }
                    </div>
                </div>
            }
            else if (isAuthenticated)
            {
                <p class="text-muted small mb-3">Only the author can add updates. You can like and comment.</p>
            }
            else
            {
                <p class="text-muted small mb-3"><a href="/Account/Login">Login</a> to like and comment.</p>
            }

            @if (posts is null)
            {
                <p>Loading updates...</p>
            }
            else if (!posts.Any())
            {
                <p class="text-muted">No updates yet. @(isOwnPost ? "Share the first one." : "")</p>
            }
            else
            {
                @foreach (var post in posts)
                {
                    var postLiked = currentUserId != null &&
                                    (post.Likes?.Any(l => l.UserId == currentUserId) ?? false);
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between small text-muted mb-2">
                                <span><strong>@(post.User?.DisplayName ?? "User")</strong></span>
                                <span>@post.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <div style="white-space: pre-wrap;" class="mb-2">@post.Content</div>
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl" alt="" class="img-fluid rounded mb-2"
                                     style="max-height: 280px; object-fit: cover;" />
                            }

                            <div class="d-flex gap-2 align-items-center mb-2">
                                @if (isAuthenticated)
                                {
                                    <button type="button"
                                            class="btn btn-sm @(postLiked ? "btn-danger" : "btn-outline-danger")"
                                            @onclick="() => TogglePostLike(post.Id)">
                                        @(postLiked ? "♥" : "♡") @(post.Likes?.Count ?? 0)
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">♡ @(post.Likes?.Count ?? 0)</span>
                                }
                            </div>

                            <div class="border-top pt-2">
                                <div class="small fw-semibold mb-1">Comments</div>
                                @if (isAuthenticated)
                                {
                                    <div class="input-group input-group-sm mb-2">
                                        <input class="form-control"
                                               value="@GetDraft(post.Id)"
                                               @oninput="(ChangeEventArgs e) => SetDraft(post.Id, e.Value?.ToString())"
                                               placeholder="Write a kind comment..." />
                                        <button type="button"
                                                class="btn btn-outline-primary"
                                                @onclick="() => AddPostComment(post.Id)">
                                            Post
                                        </button>
                                    </div>
                                }
                                @if (post.Comments != null && post.Comments.Any())
                                {
                                    @foreach (var c in post.Comments.OrderBy(x => x.CreatedAt))
                                    {
                                        <div class="small mb-1">
                                            <strong>@(c.User?.DisplayName ?? "User")</strong>
                                            <span class="text-muted">· @c.CreatedAt.ToLocalTime().ToString("MMM dd HH:mm")</span>
                                            <div style="white-space: pre-wrap;">@c.Content</div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small">No comments yet.</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }

            <hr class="my-4" />

            <h4>Comments on this post</h4>

            @if (isAuthenticated)
            {
                <div class="mb-3">
                    <textarea class="form-control mb-2" rows="2" @bind="newComment"
                              placeholder="Write a comment..."></textarea>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="AddComment"
                            disabled="@string.IsNullOrWhiteSpace(newComment)">
                        Post comment
                    </button>
                </div>
            }

            @if (project.Comments != null && project.Comments.Any())
            {
                @foreach (var c in project.Comments.OrderByDescending(x => x.CreatedAt))
                {
                    <div class="border rounded p-3 mb-2">
                        <div class="d-flex justify-content-between small">
                            <strong>@(c.User?.DisplayName ?? "User")</strong>
                            <span class="text-muted">@c.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                        </div>
                        <div style="white-space: pre-wrap;">@c.Content</div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted small">No comments yet.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Project? project;
    private List<VibePost>? posts;
    private bool notFound;
    private bool isAuthenticated;
    private bool hasLiked;
    private int likeCount;
    private string? currentUserId;
    private string newComment = string.Empty;
    private bool isFollowing;
    private bool isOwnPost;

    private string newPostText = string.Empty;
    private IBrowserFile? postFile;
    private bool postBusy;
    private string? postError;
    private Dictionary<int, string> commentDrafts = new();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private string GetDraft(int postId)
        => commentDrafts.TryGetValue(postId, out var text) ? text : string.Empty;

    private void SetDraft(int postId, string? text)
        => commentDrafts[postId] = text ?? string.Empty;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        project = await db.Projects
            .AsNoTracking()
            .Include(p => p.User)
            .Include(p => p.Likes)
            .Include(p => p.Comments)!
                .ThenInclude(c => c.User)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (project is null)
        {
            notFound = true;
            posts = new();
            return;
        }

        notFound = false;
        likeCount = project.Likes?.Count ?? 0;

        var state = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = state.User.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            var user = await UserManager.GetUserAsync(state.User);
            currentUserId = user?.Id;
            hasLiked = currentUserId != null &&
                       (project.Likes?.Any(l => l.UserId == currentUserId) ?? false);
            isOwnPost = currentUserId != null && project.UserId == currentUserId;
            isFollowing = currentUserId != null &&
                await db.Follows.AsNoTracking().AnyAsync(f =>
                    f.FollowerId == currentUserId && f.FollowingId == project.UserId);
        }
        else
        {
            currentUserId = null;
            hasLiked = false;
            isOwnPost = false;
            isFollowing = false;
        }

        posts = await db.VibePosts
            .AsNoTracking()
            .Include(p => p.User)
            .Include(p => p.Likes)
            .Include(p => p.Comments)!
                .ThenInclude(c => c.User)
            .Where(p => p.ProjectId == Id)
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();

        foreach (var p in posts)
        {
            commentDrafts.TryAdd(p.Id, string.Empty);
        }
    }

    private void OnPostFile(InputFileChangeEventArgs e) => postFile = e.File;

    private async Task AddPost()
{
    if (!isOwnPost || currentUserId is null || string.IsNullOrWhiteSpace(newPostText))
        return;

    postBusy = true;
    postError = null;

    try
    {
        string? imageUrl = null;
        if (postFile is not null)
        {
            imageUrl = await Cloudinary.UploadAsync(postFile);
            if (imageUrl is null)
            {
                postError = Cloudinary.LastError
                    ?? "Image upload failed. Try a smaller jpg/png (under 2–3 MB).";
                return;
            }
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        db.VibePosts.Add(new VibePost
        {
            ProjectId = Id,
            UserId = currentUserId,
            Content = newPostText.Trim(),
            ImageUrl = imageUrl,
            CreatedAt = DateTime.UtcNow
        });

        await db.SaveChangesAsync();

        newPostText = string.Empty;
        postFile = null;
        await LoadAsync();
    }
    catch (Exception ex)
    {
        postError = ex.InnerException?.Message ?? ex.Message;
        Console.WriteLine(ex);
    }
    finally
    {
        postBusy = false;
    }
}
    private async Task TogglePostLike(int postId)
    {
        if (currentUserId is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.PostLikes
            .FirstOrDefaultAsync(l => l.VibePostId == postId && l.UserId == currentUserId);

        if (existing is not null)
            db.PostLikes.Remove(existing);
        else
            db.PostLikes.Add(new PostLike
            {
                VibePostId = postId,
                UserId = currentUserId,
                CreatedAt = DateTime.UtcNow
            });

        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task AddPostComment(int postId)
    {
        if (currentUserId is null) return;

        var text = GetDraft(postId);
        if (string.IsNullOrWhiteSpace(text)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.PostComments.Add(new PostComment
        {
            VibePostId = postId,
            UserId = currentUserId,
            Content = text.Trim(),
            CreatedAt = DateTime.UtcNow
        });
        await db.SaveChangesAsync();
        SetDraft(postId, string.Empty);
        await LoadAsync();
    }

    private async Task ToggleLike()
    {
        if (currentUserId is null || project is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Likes
            .FirstOrDefaultAsync(l => l.ProjectId == Id && l.UserId == currentUserId);

        if (existing is not null)
            db.Likes.Remove(existing);
        else
            db.Likes.Add(new Like
            {
                ProjectId = Id,
                UserId = currentUserId,
                CreatedAt = DateTime.UtcNow
            });

        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task ToggleFollow()
    {
        if (currentUserId is null || project is null || isOwnPost) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Follows.FirstOrDefaultAsync(f =>
            f.FollowerId == currentUserId && f.FollowingId == project.UserId);

        if (existing is not null)
            db.Follows.Remove(existing);
        else
            db.Follows.Add(new Follow
            {
                FollowerId = currentUserId,
                FollowingId = project.UserId,
                CreatedAt = DateTime.UtcNow
            });

        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private async Task AddComment()
    {
        if (currentUserId is null || string.IsNullOrWhiteSpace(newComment)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.Comments.Add(new Comment
        {
            ProjectId = Id,
            UserId = currentUserId,
            Content = newComment.Trim(),
            CreatedAt = DateTime.UtcNow
        });
        await db.SaveChangesAsync();
        newComment = string.Empty;
        await LoadAsync();
    }
}