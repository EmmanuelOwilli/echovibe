@page "/feed"
@rendermode InteractiveServer
@attribute [Authorize]
@using EchoVibe.Data
@using EchoVibe.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Following Feed - EchoVibe</PageTitle>

<h1>Following feed</h1>
<p class="text-muted">Vibes from people you follow.</p>

@if (items is null)
{
    <p>Loading...</p>
}
else if (!items.Any())
{
    <p class="text-muted">
        No vibes yet. <a href="search">Search users</a>, open their vibe, and tap Follow —
        or <a href="following">see who you follow</a>.
    </p>
}
else
{
    <div class="row g-4">
        @foreach (var p in items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Title"
                             style="height:180px;object-fit:cover;" />
                    }
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(p.VibeType))
                        {
                            <span class="badge bg-primary mb-2">@p.VibeType</span>
                        }
                        <h5>@p.Title</h5>
                        <p class="small text-muted">By @(p.User?.DisplayName ?? "User")</p>
                        <a class="btn btn-sm btn-outline-primary" href="@($"vibes/{p.Id}")">View Vibe</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Project>? items;

    protected override async Task OnInitializedAsync()
{
    await using var db = await DbFactory.CreateDbContextAsync();

    // use db only — never Db
    // example:
    // people = await db.Follows.AsNoTracking()...
}
}