@page "/feed/new"
@rendermode InteractiveServer
@attribute [Authorize]
@using EchoVibe.Data
@using EchoVibe.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>New Vibes - EchoVibe</PageTitle>

<h1>New vibes</h1>
<p class="text-muted">Newest projects from the community.</p>

@if (items is null)
{
    <p>Loading...</p>
}
else if (!items.Any())
{
    <p class="text-muted">No vibes yet.</p>
}
else
{
    <div class="row g-4">
        @foreach (var p in items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" class="card-img-top" alt="@p.Title"
                             style="height:180px;object-fit:cover;" />
                    }
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(p.VibeType))
                        {
                            <span class="badge bg-primary mb-2">@p.VibeType</span>
                        }
                        <h5>@p.Title</h5>
                        <p class="small text-muted">
                            By @(p.User?.DisplayName ?? "User") ·
                            @p.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </p>
                        <a class="btn btn-sm btn-outline-primary" href="@($"vibes/{p.Id}")">View Vibe</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Project>? items;
        

    protected override async Task OnInitializedAsync()
{
    await using var db = await DbFactory.CreateDbContextAsync();

    items = await db.Projects
        .AsNoTracking()
        .Include(p => p.User)
        .Include(p => p.Likes)
        .OrderByDescending(p => p.Likes!.Count)
        .ThenByDescending(p => p.CreatedAt)
        .Take(30)
        .ToListAsync();
}
}