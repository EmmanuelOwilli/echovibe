@page "/weather"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Weather - Uganda · EchoVibe</PageTitle>

<h1 class="mb-2">Weather in Uganda</h1>
<p class="text-muted mb-4">
    Live conditions for Kampala (Africa/Kampala). Data from Open-Meteo.
</p>

@if (loading)
{
    <p class="text-muted">Loading weather...</p>
}
else if (error is not null)
{
    <div class="alert alert-warning">@error</div>
    <button class="btn btn-outline-primary btn-sm" @onclick="LoadAsync">Try again</button>
}
else if (current is not null)
{
    <div class="card shadow-sm mb-4" style="max-width:420px;">
        <div class="card-body">
            <h5 class="card-title mb-1">@LocationName</h5>
            <div class="display-4 fw-bold">@current.Temperature.ToString("0")°C</div>
            <p class="mb-1 fs-5">@current.Description</p>
            <p class="text-muted mb-0 small">
                Wind @current.WindSpeed.ToString("0") km/h
            </p>
        </div>
    </div>

    @if (daily is not null && daily.Any())
    {
        <h2 class="h5 mb-3">Next days</h2>
        <div class="table-responsive" style="max-width:640px;">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>High</th>
                        <th>Low</th>
                        <th>Conditions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in daily)
                    {
                        <tr>
                            <td>@d.Date.ToString("ddd, MMM d")</td>
                            <td>@d.MaxTemp.ToString("0")°C</td>
                            <td>@d.MinTemp.ToString("0")°C</td>
                            <td>@d.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    // Kampala, Uganda
    private const double Latitude = 0.3476;
    private const double Longitude = 32.5825;
    private const string LocationName = "Kampala, Uganda";

    private bool loading = true;
    private string? error;
    private CurrentWeather? current;
    private List<DayForecast>? daily;

    private static CurrentWeather? _cacheCurrent;
    private static List<DayForecast>? _cacheDaily;
    private static DateTime _cacheUntil = DateTime.MinValue;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        if (_cacheCurrent is not null && DateTime.UtcNow < _cacheUntil)
        {
            current = _cacheCurrent;
            daily = _cacheDaily;
            loading = false;
            return;
        }

        try
        {
            var http = HttpClientFactory.CreateClient();
            http.Timeout = TimeSpan.FromSeconds(15);

            // current + 7-day daily
            var url =
                $"https://api.open-meteo.com/v1/forecast?" +
                $"latitude={Latitude}&longitude={Longitude}" +
                "&current=temperature_2m,weather_code,wind_speed_10m" +
                "&daily=weather_code,temperature_2m_max,temperature_2m_min" +
                "&timezone=Africa%2FKampala" +
                "&forecast_days=7";

            using var response = await http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests
                    ? "Weather service is busy (rate limit). Try again in a few minutes."
                    : $"Could not load weather (HTTP {(int)response.StatusCode}). Check server outbound HTTPS.";
                return;
            }

            var data = await response.Content.ReadFromJsonAsync<OpenMeteoResponse>();
            if (data?.Current is null)
            {
                error = "Weather data was empty. Try again later.";
                return;
            }

            current = new CurrentWeather
            {
                Temperature = data.Current.Temperature,
                WindSpeed = data.Current.WindSpeed,
                Description = WeatherCodeToText(data.Current.WeatherCode)
            };

            daily = new List<DayForecast>();
            if (data.Daily?.Time is not null)
            {
                for (var i = 0; i < data.Daily.Time.Count; i++)
                {
                    daily.Add(new DayForecast
                    {
                        Date = DateOnly.Parse(data.Daily.Time[i]),
                        MaxTemp = data.Daily.TempMax![i],
                        MinTemp = data.Daily.TempMin![i],
                        Description = WeatherCodeToText(data.Daily.WeatherCode![i])
                    });
                }
            }

            _cacheCurrent = current;
            _cacheDaily = daily;
            _cacheUntil = DateTime.UtcNow.AddMinutes(20);
        }
        catch (Exception ex)
        {
            error = $"Could not reach weather service. On Render, outbound HTTPS must be allowed. ({ex.GetType().Name})";
        }
        finally
        {
            loading = false;
        }
    }

    private static string WeatherCodeToText(int code) => code switch
    {
        0 => "Clear sky",
        1 or 2 => "Mainly clear",
        3 => "Cloudy",
        45 or 48 => "Foggy",
        51 or 53 or 55 => "Drizzle",
        61 or 63 or 65 => "Rain",
        71 or 73 or 75 => "Snow",
        80 or 81 or 82 => "Rain showers",
        95 or 96 or 99 => "Thunderstorm",
        _ => "Mixed conditions"
    };

    private sealed class CurrentWeather
    {
        public double Temperature { get; set; }
        public double WindSpeed { get; set; }
        public string Description { get; set; } = "";
    }

    private sealed class DayForecast
    {
        public DateOnly Date { get; set; }
        public double MaxTemp { get; set; }
        public double MinTemp { get; set; }
        public string Description { get; set; } = "";
    }

    private sealed class OpenMeteoResponse
    {
        [JsonPropertyName("current")]
        public OpenMeteoCurrent? Current { get; set; }

        [JsonPropertyName("daily")]
        public OpenMeteoDaily? Daily { get; set; }
    }

    private sealed class OpenMeteoCurrent
    {
        [JsonPropertyName("temperature_2m")]
        public double Temperature { get; set; }

        [JsonPropertyName("weather_code")]
        public int WeatherCode { get; set; }

        [JsonPropertyName("wind_speed_10m")]
        public double WindSpeed { get; set; }
    }

    private sealed class OpenMeteoDaily
    {
        [JsonPropertyName("time")]
        public List<string>? Time { get; set; }

        [JsonPropertyName("weather_code")]
        public List<int>? WeatherCode { get; set; }

        [JsonPropertyName("temperature_2m_max")]
        public List<double>? TempMax { get; set; }

        [JsonPropertyName("temperature_2m_min")]
        public List<double>? TempMin { get; set; }
    }
}
