@page "/weather"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@using Microsoft.JSInterop
@using System.Net.Http.Json
@using System.Text.Json.Serialization

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Weather - EchoVibe</PageTitle>

<h1 class="mb-2">Weather near you</h1>

<p class="text-muted mb-4">
    Live weather for your current location. EchoVibe uses your browser location
    to show weather for the region you are visiting from.
</p>

@if (loading)
{
    <p class="text-muted">
        Detecting your location and loading weather...
    </p>
}
else if (error is not null)
{
    <div class="alert alert-warning">
        @error
    </div>

    <button class="btn btn-outline-primary btn-sm"
            @onclick="LoadAsync">
        Try again
    </button>
}
else if (current is not null)
{
    <div class="card shadow-sm mb-4" style="max-width:420px;">
        <div class="card-body">
            <h5 class="card-title mb-1">
                @LocationName
            </h5>

            <div class="display-4 fw-bold">
                @current.Temperature.ToString("0")°C
            </div>

            <p class="mb-1 fs-5">
                @current.Description
            </p>

            <p class="text-muted mb-0 small">
                Wind @current.WindSpeed.ToString("0") km/h
            </p>
        </div>
    </div>

    @if (daily is not null && daily.Any())
    {
        <h2 class="h5 mb-3">Next days</h2>

        <div class="table-responsive" style="max-width:640px;">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>High</th>
                        <th>Low</th>
                        <th>Conditions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var d in daily)
                    {
                        <tr>
                            <td>
                                @d.Date.ToString("ddd, MMM d")
                            </td>

                            <td>
                                @d.MaxTemp.ToString("0")°C
                            </td>

                            <td>
                                @d.MinTemp.ToString("0")°C
                            </td>

                            <td>
                                @d.Description
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private bool loading = true;
    private string? error;

    private CurrentWeather? current;
    private List<DayForecast>? daily;

    private string LocationName = "Your location";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            // Ask the visitor's browser for their current coordinates.
            var location = await JS.InvokeAsync<BrowserLocation>(
                "eval",
                """
                new Promise((resolve, reject) => {
                    if (!navigator.geolocation) {
                        reject("Geolocation is not supported by this browser.");
                        return;
                    }

                    navigator.geolocation.getCurrentPosition(
                        position => resolve({
                            latitude: position.coords.latitude,
                            longitude: position.coords.longitude
                        }),
                        error => reject(error.message || "Location permission was not granted."),
                        {
                            enableHighAccuracy: false,
                            timeout: 10000,
                            maximumAge: 600000
                        }
                    );
                })
                """);

            var latitude = Math.Clamp(location.Latitude, -90, 90);
            var longitude = Math.Clamp(location.Longitude, -180, 180);

            var http = HttpClientFactory.CreateClient();
            http.Timeout = TimeSpan.FromSeconds(15);

            LocationName = await GetLocationNameAsync(
                http,
                latitude,
                longitude);

            var lat =
                latitude.ToString(
                    System.Globalization.CultureInfo.InvariantCulture);

            var lon =
                longitude.ToString(
                    System.Globalization.CultureInfo.InvariantCulture);

            var url =
                $"https://api.open-meteo.com/v1/forecast?" +
                $"latitude={lat}&longitude={lon}" +
                "&current=temperature_2m,weather_code,wind_speed_10m" +
                "&daily=weather_code,temperature_2m_max,temperature_2m_min" +
                "&timezone=auto" +
                "&forecast_days=7";

            using var response = await http.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode ==
                        System.Net.HttpStatusCode.TooManyRequests
                    ? "Weather service is busy (rate limit). Try again in a few minutes."
                    : $"Could not load weather (HTTP {(int)response.StatusCode}).";

                return;
            }

            var data =
                await response.Content.ReadFromJsonAsync<OpenMeteoResponse>();

            if (data?.Current is null)
            {
                error = "Weather data was empty. Try again later.";
                return;
            }

            current = new CurrentWeather
            {
                Temperature = data.Current.Temperature,
                WindSpeed = data.Current.WindSpeed,
                Description = WeatherCodeToText(
                    data.Current.WeatherCode)
            };

            daily = new List<DayForecast>();

            if (data.Daily?.Time is not null &&
                data.Daily.WeatherCode is not null &&
                data.Daily.TempMax is not null &&
                data.Daily.TempMin is not null)
            {
                var count = new[]
                {
                    data.Daily.Time.Count,
                    data.Daily.WeatherCode.Count,
                    data.Daily.TempMax.Count,
                    data.Daily.TempMin.Count
                }.Min();

                for (var i = 0; i < count; i++)
                {
                    if (!DateOnly.TryParse(
                            data.Daily.Time[i],
                            out var date))
                    {
                        continue;
                    }

                    daily.Add(new DayForecast
                    {
                        Date = date,
                        MaxTemp = data.Daily.TempMax[i],
                        MinTemp = data.Daily.TempMin[i],
                        Description = WeatherCodeToText(
                            data.Daily.WeatherCode[i])
                    });
                }
            }
        }
        catch (JSException)
        {
            error =
                "We couldn't access your location. Please allow location access in your browser and try again.";
        }
        catch (TaskCanceledException)
        {
            error =
                "Location or weather detection took too long. Please try again.";
        }
        catch
        {
            error =
                "Could not reach the weather service. Please try again later.";
        }
        finally
        {
            loading = false;
        }
    }

    private static async Task<string> GetLocationNameAsync(
        HttpClient http,
        double latitude,
        double longitude)
    {
        try
        {
            var lat =
                latitude.ToString(
                    System.Globalization.CultureInfo.InvariantCulture);

            var lon =
                longitude.ToString(
                    System.Globalization.CultureInfo.InvariantCulture);

            var url =
                $"https://geocoding-api.open-meteo.com/v1/reverse?" +
                $"latitude={lat}&longitude={lon}&count=1&language=en&format=json";

            using var response = await http.GetAsync(url);

            if (!response.IsSuccessStatusCode)
            {
                return "Your location";
            }

            var data =
                await response.Content.ReadFromJsonAsync<ReverseGeocodingResponse>();

            var result = data?.Results?.FirstOrDefault();

            if (result is null)
            {
                return "Your location";
            }

            var parts = new[]
            {
                result.Name,
                result.Admin1,
                result.Country
            }
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();

            return parts.Count > 0
                ? string.Join(", ", parts)
                : "Your location";
        }
        catch
        {
            return "Your location";
        }
    }

    private static string WeatherCodeToText(int code) => code switch
    {
        0 => "Clear sky",
        1 or 2 => "Mainly clear",
        3 => "Cloudy",
        45 or 48 => "Foggy",
        51 or 53 or 55 => "Drizzle",
        61 or 63 or 65 => "Rain",
        71 or 73 or 75 => "Snow",
        80 or 81 or 82 => "Rain showers",
        95 or 96 or 99 => "Thunderstorm",
        _ => "Mixed conditions"
    };

    private sealed class BrowserLocation
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }

    private sealed class CurrentWeather
    {
        public double Temperature { get; set; }
        public double WindSpeed { get; set; }
        public string Description { get; set; } = "";
    }

    private sealed class DayForecast
    {
        public DateOnly Date { get; set; }
        public double MaxTemp { get; set; }
        public double MinTemp { get; set; }
        public string Description { get; set; } = "";
    }

    private sealed class OpenMeteoResponse
    {
        [JsonPropertyName("current")]
        public OpenMeteoCurrent? Current { get; set; }

        [JsonPropertyName("daily")]
        public OpenMeteoDaily? Daily { get; set; }
    }

    private sealed class OpenMeteoCurrent
    {
        [JsonPropertyName("temperature_2m")]
        public double Temperature { get; set; }

        [JsonPropertyName("weather_code")]
        public int WeatherCode { get; set; }

        [JsonPropertyName("wind_speed_10m")]
        public double WindSpeed { get; set; }
    }

    private sealed class OpenMeteoDaily
    {
        [JsonPropertyName("time")]
        public List<string>? Time { get; set; }

        [JsonPropertyName("weather_code")]
        public List<int>? WeatherCode { get; set; }

        [JsonPropertyName("temperature_2m_max")]
        public List<double>? TempMax { get; set; }

        [JsonPropertyName("temperature_2m_min")]
        public List<double>? TempMin { get; set; }
    }

    private sealed class ReverseGeocodingResponse
    {
        [JsonPropertyName("results")]
        public List<ReverseGeocodingResult>? Results { get; set; }
    }

    private sealed class ReverseGeocodingResult
    {
        [JsonPropertyName("name")]
        public string? Name { get; set; }

        [JsonPropertyName("admin1")]
        public string? Admin1 { get; set; }

        [JsonPropertyName("country")]
        public string? Country { get; set; }
    }
}